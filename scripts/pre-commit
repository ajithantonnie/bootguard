#!/usr/bin/env bash

# BootGuard Git Pre-commit Hook

# This hook runs BootGuard to scan the repository for Spring Boot security risks.

# Find the repository root directory
REPO_ROOT=$(git rev-parse --show-toplevel)

CACHE_DIR="$HOME/.bootguard"
JAR_PATH="$CACHE_DIR/bootguard.jar"
LATEST_RELEASE_URL="https://github.com/ajithantonnie/bootguard/releases/latest/download/bootguard.jar"

# Download the JAR if it hasn't been cached locally
if [ ! -f "$JAR_PATH" ]; then
  echo "[BootGuard Pre-commit] BootGuard scanner not found locally."
  echo "[BootGuard Pre-commit] Downloading latest release to $JAR_PATH..."
  mkdir -p "$CACHE_DIR"
  curl -sL "$LATEST_RELEASE_URL" -o "$JAR_PATH" || {
    echo "[BootGuard Pre-commit] ERROR: Failed to download BootGuard. Commit aborted."
    exit 1
  }
fi

echo "[BootGuard Pre-commit] Running security scan..."

# Run BootGuard against the repository root.
# Change --fail-on to MEDIUM or LOW if you want stricter checks.
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [[ "$CURRENT_BRANCH" == "main" || "$CURRENT_BRANCH" == "master" || "$CURRENT_BRANCH" == "production" || "$CURRENT_BRANCH" == release/* ]]; then
  java -jar "$JAR_PATH" "$REPO_ROOT" --fail-on HIGH
  EXIT_CODE=$?

  if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ [BootGuard Pre-commit] Security issues found! Commit aborted for branch '$CURRENT_BRANCH'."
    echo "Please fix the issues listed above or use 'git commit --no-verify' to bypass (not recommended)."
    exit 1
  fi
else
  echo "[BootGuard Pre-commit] Non-production branch ('$CURRENT_BRANCH') detected. Running in warning-only mode."
  # We still run it to show warnings, but we ignore the exit code so it doesn't block the commit.
  java -jar "$JAR_PATH" "$REPO_ROOT" --fail-on HIGH || true
fi

echo "✅ [BootGuard Pre-commit] Scan finished."
exit 0
